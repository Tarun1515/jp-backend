<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    JP.App.Api — masters, approval engine and business surface.
    Reads/writes jp_mdm and jp_app. Validates identity by JWT issued by
    JP.Sso.Api; both APIs must share the same Jwt:Key.
  -->

  <PropertyGroup>
    <RootNamespace>JP.App.Api</RootNamespace>
    <UserSecretsId>jp-app-api-3d5b9e71-2c48-4f6a-8b10-7a9c62e5d834</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JP.Core\JP.Core.csproj" />
    <ProjectReference Include="..\JP.Domain\JP.Domain.csproj" />
    <ProjectReference Include="..\JP.Infrastructure\JP.Infrastructure.csproj" />
  </ItemGroup>

</Project>
